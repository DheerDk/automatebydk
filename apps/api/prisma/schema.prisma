// Prisma Schema for ChatFlow AI (Multi-Tenant WhatsApp AI Automation Platform)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  password        String
  name            String
  phone           String?
  role            String       @default("BUSINESS_OWNER")
  avatarUrl       String?
  resetToken      String?
  resetExpires    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships     Membership[]
  assignedLeads   Lead[]
  assignedConvs   Conversation[]
  leadEvents      LeadEvent[]
  auditLogs       AuditLog[]
  notifications   Notification[]
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  logoUrl           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  memberships       Membership[]
  settings          BusinessSettings?
  whatsappAccount   WhatsAppAccount?
  categories        Category[]
  products          Product[]
  customers         Customer[]
  conversations     Conversation[]
  messages          Message[]
  leads             Lead[]
  leadEvents        LeadEvent[]
  automations       AutomationRule[]
  templates         MessageTemplate[]
  campaigns         Campaign[]
  aiConversations   AiConversation[]
  aiSearches        AiSearch[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  subscription      Subscription?
  payments          Payment[]
}

model Membership {
  id              String       @id @default(cuid())
  userId          String
  organizationId  String
  role            String       @default("STAFF")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model BusinessSettings {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  currency              String       @default("INR")
  businessHours         String?      @default("Mon-Sat: 10:00 AM - 08:00 PM")
  deliveryPolicy        String?      @default("Standard delivery within 2-4 business days.")
  returnPolicy          String?      @default("7-day easy returns and exchanges available.")
  exchangePolicy        String?      @default("Free size exchange within 7 days.")
  paymentMethods        String?      @default("UPI, Credit/Debit Cards, Cash on Delivery (COD), Net Banking")
  welcomeMessage        String?      @default("👋 Welcome to our store! Reply with a number:\n1️⃣ Browse Products\n2️⃣ Search Product\n3️⃣ Offers & Deals\n4️⃣ Talk to Support")
  aiAutoReplyEnabled    Boolean      @default(true)
  onlyUnsavedContacts   Boolean      @default(false)
  excludedNumbers       String       @default("")
  humanHandoffKeywords  String       @default("human,agent,support,help,person,representative")
  address               String?
  phone                 String?
  email                 String?
  website               String?
  instagram             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WhatsAppAccount {
  id                    String                   @id @default(cuid())
  organizationId        String                   @unique
  phoneNumberId         String
  businessAccountId     String
  accessToken           String
  verifyToken           String
  displayPhoneNumber    String?
  metaAppSecret         String?
  status                String                   @default("DISCONNECTED")
  lastWebhookReceivedAt DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Category {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  description     String?
  imageUrl        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products        Product[]

  @@unique([organizationId, slug])
}

model Product {
  id              String       @id @default(cuid())
  organizationId  String
  categoryId      String?
  name            String
  sku             String
  description     String?
  price           Float
  discountPrice   Float?
  brand           String?
  color           String?
  size            String?
  stock           Int          @default(0)
  stockStatus     String       @default("IN_STOCK")
  images          String       @default("[]") // JSON string of image URLs
  tags            String       @default("[]") // JSON string of tags
  isActive        Boolean      @default(true)
  enquiryCount    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  leads           Lead[]

  @@unique([organizationId, sku])
}

model Customer {
  id                String            @id @default(cuid())
  organizationId    String
  name              String
  phone             String
  email             String?
  tags              String            @default("[]") // JSON string of tags
  notes             String?
  lastInteractionAt DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  messages          Message[]
  leads             Lead[]
  aiConversations   AiConversation[]
  aiSearches        AiSearch[]

  @@unique([organizationId, phone])
}

model Conversation {
  id                String             @id @default(cuid())
  organizationId    String
  customerId        String
  status            String             @default("AI_ACTIVE")
  assignedUserId    String?
  lastMessageText   String?
  lastMessageAt     DateTime           @default(now())
  unreadCount       Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser      User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages          Message[]
  aiConversations   AiConversation[]

  @@unique([organizationId, customerId])
}

model Message {
  id                String            @id @default(cuid())
  organizationId    String
  conversationId    String
  customerId        String
  direction         String
  type              String            @default("TEXT")
  status            String            @default("SENT")
  content           String
  mediaUrl          String?
  metadata          String?           // JSON string
  whatsappMessageId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Lead {
  id              String       @id @default(cuid())
  organizationId  String
  customerId      String
  productId       String?
  status          String       @default("NEW")
  source          String       @default("WHATSAPP")
  assignedUserId  String?
  estimatedValue  Float?
  notes           String?
  convertedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  assignedUser    User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  events          LeadEvent[]
}

model LeadEvent {
  id              String       @id @default(cuid())
  organizationId  String
  leadId          String
  userId          String?
  fromStatus      String?
  toStatus        String
  note            String?
  createdAt       DateTime     @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AutomationRule {
  id              String            @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  trigger         String
  conditions      String            @default("{}") // JSON string
  actions         String            @default("[]") // JSON string
  flowData        String?           // JSON string storing visual node graph
  isActive        Boolean           @default(true)
  executionCount  Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model MessageTemplate {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  category        String       @default("MARKETING")
  language        String       @default("en")
  body            String
  variables       String       @default("[]") // JSON string
  status          String       @default("APPROVED")
  metaTemplateId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns       Campaign[]

  @@unique([organizationId, name])
}

model Campaign {
  id              String            @id @default(cuid())
  organizationId  String
  templateId      String?
  name            String
  customMessage   String?
  targetAudience  String            @default("{}") // JSON string
  status          String            @default("DRAFT")
  scheduledAt     DateTime?
  sentCount       Int               @default(0)
  deliveredCount  Int               @default(0)
  readCount       Int               @default(0)
  failedCount     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        MessageTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model AiConversation {
  id                String       @id @default(cuid())
  organizationId    String
  customerId        String
  conversationId    String
  summary           String?
  sentiment         String?      @default("NEUTRAL")
  detectedIntents   String       @default("[]") // JSON string
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AiSearch {
  id                String       @id @default(cuid())
  organizationId    String
  customerId        String?
  query             String
  extractedFilters  String       @default("{}") // JSON string
  resultsCount      Int          @default(0)
  createdAt         DateTime     @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model Notification {
  id              String       @id @default(cuid())
  organizationId  String
  userId          String?
  title           String
  message         String
  type            String       @default("INFO")
  isRead          Boolean      @default(false)
  link            String?
  createdAt       DateTime     @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id              String       @id @default(cuid())
  organizationId  String?
  userId          String?
  action          String
  entityType      String
  entityId        String?
  details         String?      // JSON string
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime     @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Subscription {
  id                  String               @id @default(cuid())
  organizationId      String               @unique
  planTier            String               @default("FREE")
  status              String               @default("ACTIVE")
  currentPeriodStart  DateTime             @default(now())
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments            Payment[]
}

model Plan {
  id                String               @id @default(cuid())
  tier              String               @unique
  name              String
  priceMonthly      Float
  priceYearly       Float
  maxProducts       Int                  @default(50)
  maxConversations  Int                  @default(500)
  maxUsers          Int                  @default(2)
  maxAutomations    Int                  @default(5)
  maxCampaigns      Int                  @default(2)
  aiSearchLimit     Int                  @default(1000)
  features          String               @default("[]") // JSON string
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Payment {
  id              String       @id @default(cuid())
  organizationId  String
  subscriptionId  String?
  amount          Float
  currency        String       @default("INR")
  status          String       @default("COMPLETED")
  paymentMethod   String       @default("CARD")
  transactionId   String       @unique
  createdAt       DateTime     @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
}
