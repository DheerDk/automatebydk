# ==========================================
# AutoMate by DK API - Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=production
FRONTEND_URL=https://automatebydk.com
BACKEND_URL=https://api.automatebydk.com

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication & Security Keys
# -----------------------------------------------------------------------------
SESSION_SECRET="your_production_session_secret_min_32_characters_random_hex"
JWT_SECRET="your_production_jwt_signing_secret_min_32_characters"
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_min_32_characters"
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_REDIRECT_URI="https://automatebydk.com/auth/google/callback"

# -----------------------------------------------------------------------------
# SMS / Phone OTP Providers
# -----------------------------------------------------------------------------
SMS_PROVIDER="twilio"
SMS_PROVIDER_API_KEY="your_sms_provider_api_key"
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_PHONE="+1XXXXXXXXXX"
FAST2SMS_API_KEY="your_fast2sms_api_key"

# -----------------------------------------------------------------------------
# Transactional Email Providers (Resend / SendGrid / SMTP)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER_API_KEY="re_123456789_your_resend_or_sendgrid_api_key"
EMAIL_FROM="AutoMate Security <no-reply@automatebydk.com>"

SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# -----------------------------------------------------------------------------
META_GRAPH_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN="your_whatsapp_system_user_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_waba_id_here"
WHATSAPP_VERIFY_TOKEN="chatflow_webhook_verify_token_secure_xyz_987"
META_APP_SECRET="your_meta_app_secret_here"

MOCK_WHATSAPP=false
MOCK_AI=false

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"

# -----------------------------------------------------------------------------
# Payment & Razorpay
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
