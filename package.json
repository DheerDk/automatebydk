{
  "name": "chatflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant WhatsApp AI Automation SaaS Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@chatflow/api",
    "dev:web": "npm run dev --workspace=@chatflow/web",
    "start": "node apps/api/dist/index.js",
    "start:api": "node apps/api/dist/index.js",
    "build": "npm run build:shared && npm run db:generate && npm run build:api",
    "build:shared": "npm run build --workspace=@chatflow/shared",
    "build:api": "npm run build --workspace=@chatflow/api",
    "build:web": "npm run build --workspace=@chatflow/web",
    "build:prod": "npm install --include=dev && npm run build:shared && npm run db:generate && npm run build:api && npm run db:push",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@chatflow/api",
    "db:push": "npm run db:push --workspace=@chatflow/api",
    "db:seed": "npm run db:seed --workspace=@chatflow/api",
    "db:migrate": "npm run db:migrate --workspace=@chatflow/api",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "prisma": "^5.22.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "whatsapp",
    "saas",
    "automation",
    "ai",
    "crm",
    "multi-tenant",
    "meta-cloud-api"
  ],
  "author": "ChatFlow AI Team",
  "license": "MIT"
}
